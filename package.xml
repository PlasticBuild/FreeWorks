<!-- FreeWorks public alpha metadata. -->
<package format="1" xmlns="https://wiki.freecad.org/Package_Metadata">
  <name>FreeWorks</name>
  <description>A familiar mainstream-CAD front end for stock FreeCAD: command ribbon, property panels,
    feature tree with rollback bar, view selector, sketch tools with inference snapping and automatic
    relations, smart dimensions and relation tools. Pure Python; no FreeCAD patches needed.</description>
  <version>0.3.2-alpha</version>
  <date>2026-11-22</date>
  <maintainer email="341840710+PlasticBuild@users.noreply.github.com">PlasticBuild</maintainer>
  <license file="LICENSE">LGPL-2.1-or-later</license>
  <url type="repository" branch="main">https://github.com/PlasticBuild/FreeWorks</url>
  <url type="bugtracker">https://github.com/PlasticBuild/FreeWorks/issues</url>
  <url type="readme">https://github.com/PlasticBuild/FreeWorks/blob/main/README.md</url>
  <icon>icons/freeworks.svg</icon>
  <freecadmin>1.1.0</freecadmin>
  <content>
    <workbench>
      <!-- Not a switchable workbench: InitGui.py restyles the main window at start-up. The Addon Manager
           installs the folder under Mod/FreeWorks and FreeCAD runs InitGui.py at every start. -->
      <name>FreeWorks</name>
      <subdirectory>./</subdirectory>
      <icon>icons/freeworks.svg</icon>
      <tag>ui</tag>
      <tag>sketcher</tag>
      <tag>partdesign</tag>
      <tag>assembly</tag>
    </workbench>
  </content>
</package>
